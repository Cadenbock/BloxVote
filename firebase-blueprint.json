{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "A Roblox game that can be voted for.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the game." },
        "description": { "type": "string", "description": "A short description of the game." },
        "imageUrl": { "type": "string", "description": "URL to the game's thumbnail image." },
        "votes": { "type": "number", "description": "Total number of votes received." },
        "creator": { "type": "string", "description": "The creator of the game." },
        "robloxUrl": { "type": "string", "description": "Link to the game on Roblox." },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID of the user who added this game." }
      },
      "required": ["name", "imageUrl", "votes", "creator", "robloxUrl", "createdAt", "createdBy"]
    },
    "Vote": {
      "title": "Vote",
      "description": "A vote cast by a user for a specific game.",
      "type": "object",
      "properties": {
        "gameId": { "type": "string", "description": "The ID of the game being voted for." },
        "userId": { "type": "string", "description": "The UID of the user who cast the vote." },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["gameId", "userId", "timestamp"]
    },
    "GlobalAnnouncement": {
      "title": "GlobalAnnouncement",
      "description": "Global announcement banner config.",
      "type": "object",
      "properties": {
        "message": { "type": "string", "description": "The announcement text." },
        "enabled": { "type": "boolean", "description": "Whether the announcement banner is active." },
        "durationSeconds": { "type": "number", "description": "How many seconds the announcement banner remains visible before auto-dismissing." },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "description": "Email or UID of the admin who updated the announcement." }
      },
      "required": ["message", "enabled"]
    },
    "AdminChatMessage": {
      "title": "AdminChatMessage",
      "description": "Messages exchanged between admins in the Admin Suite chat.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderDisplayName": { "type": "string" },
        "senderPhotoURL": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderEmail", "senderDisplayName", "text", "timestamp"]
    },
    "PublicChatMessage": {
      "title": "PublicChatMessage",
      "description": "Public chat messages visible to everyone.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "senderDisplayName": { "type": "string" },
        "senderPhotoURL": { "type": "string" },
        "senderColor": { "type": "string" },
        "senderTheme": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderDisplayName", "text", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata including coins and cosmetic inventory.",
      "type": "object",
      "properties": {
        "coins": { "type": "number" },
        "equippedColor": { "type": "string" },
        "purchasedColors": { "type": "array", "items": { "type": "string" } },
        "equippedTheme": { "type": "string" },
        "purchasedThemes": { "type": "array", "items": { "type": "string" } },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastDailyBonusDate": { "type": "string" }
      }
    },
    "UpdateLog": {
      "title": "UpdateLog",
      "description": "Public update log or patch note entry published by administrators.",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["major", "feature", "fix", "balance"] },
        "changes": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" }
      },
      "required": ["title", "category", "changes", "timestamp"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notifications for direct messages, rewards, system updates, and streak alerts.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" },
        "linkAction": { "type": "string" }
      },
      "required": ["type", "title", "message", "isRead"]
    }
  },
  "firestore": {
    "/games": {
      "schema": "Game",
      "description": "Collection of Roblox games."
    },
    "/games/{gameId}/votes": {
      "schema": "Vote",
      "description": "Subcollection of votes for a specific game."
    },
    "/globalAnnouncement/{docId}": {
      "schema": "GlobalAnnouncement",
      "description": "Global announcement document for site-wide notices."
    },
    "/adminChat/{messageId}": {
      "schema": "AdminChatMessage",
      "description": "Realtime admin communication channel."
    },
    "/updateLogs/{logId}": {
      "schema": "UpdateLog",
      "description": "Public site update and patch notes."
    },
    "/publicChat/{messageId}": {
      "schema": "PublicChatMessage",
      "description": "Public global live chat room."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing coins and cosmetics."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Subcollection of user notifications."
    },
    "/customTitleRequests/{requestId}": {
      "schema": "CustomTitleRequest",
      "description": "Custom title requests submitted by users for admin approval."
    },
    "/customAdminTitles/{titleId}": {
      "schema": "CustomAdminTitle",
      "description": "Custom titles added by admins for the shop."
    },
    "/customAdminFonts/{fontId}": {
      "schema": "CustomAdminFont",
      "description": "Custom fonts added by admins for the shop."
    }
  }
}

