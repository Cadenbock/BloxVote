rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return (request.auth != null && request.auth.token.email != null && request.auth.token.email.matches("(?i)^mondo7108@gmail\\.com$")) ||
             (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
             (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Global catch-all match for all collections and subcollections
    match /{document=**} {
      allow read, write: if true;
    }

    match /test/connection {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /activities/{activityId} {
      allow read, write: if true;
    }

    match /games/{gameId} {
      allow read, write: if true;

      match /votes/{voteId} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;

      match /votes/{gameId} {
        allow read, write: if true;
      }

      match /notifications/{notificationId} {
        allow read, write: if true;
      }
    }

    match /publicChat/{messageId} {
      allow read, write: if true;
    }

    match /chatFlags/{flagId} {
      allow read, write: if true;
    }

    match /bannedUsers/{userId} {
      allow read, write: if true;
    }

    match /globalAnnouncement/{docId} {
      allow read, write: if true;
    }

    match /adminChat/{messageId} {
      allow read, write: if true;
    }

    match /updateLogs/{logId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /customTitleRequests/{requestId} {
      allow read, write: if true;
    }

    match /avatarRequests/{requestId} {
      allow read, write: if true;
    }

    match /customAdminTitles/{titleId} {
      allow read, write: if true;
    }

    match /customAdminFonts/{fontId} {
      allow read, write: if true;
    }

    match /userFeedback/{feedbackId} {
      allow read, write: if true;
    }
  }
}
